{% extends "layout/default.twig" %}

{% block title %}404 Not Found{% endblock %}

{% block content %}
<div class="text-center py-12">
  <h1 class="text-6xl font-bold text-red-500 mb-4">404</h1>
  <h2 class="text-2xl font-semibold mb-4">Oops! This is 404 awkward.</h2>
  <p class="mb-4">We encountered a 404 Not Found error.</p>
  <p class="mb-8">You are looking for something that doesn't exist or may have moved. Check out one of the links on this page or head back to <a href="{{ url('home') }}" class="text-blue-500 hover:underline">Home</a>.</p>
</div>
{% endblock %}
