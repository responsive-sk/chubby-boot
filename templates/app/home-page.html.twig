<!DOCTYPE html>
<html lang="sk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body>
    <!-- Na začiatok body -->
<!--     <div 
      data-component="PageLoader" 
      data-props='{
        "message": "Preparing your experience...",
        "showProgress": true
      }'>
    </div> -->
    <!-- Server-rendered Header -->
    <header class="header">
        <div class="container">
            <div data-component="Logo"></div>
            <!-- Logo -->
            <div class="logo">
                <a href="/" class="logo-link">
                    <span class="logo-text">Boson PHP</span>
                </a>
            </div>
            <!-- Desktop Navigation - Server rendered -->
            <nav class="desktop-nav">
                {% for item in navigation %}
                    <a href="{{ item.href }}" 
                       class="nav-link {% if item.current %}active{% endif %}">
                        {{ item.name }}
                    </a>
                {% endfor %}
            </nav>

            <!-- Interactive parts - Enhanced by Svelte -->
            <div data-component="HeaderActions"></div>
        </div>

        <!-- Mobile Navigation - Enhanced by Svelte -->
        <div data-component="MobileMenu" 
             data-props="{{ {navigation: navigation}|json_encode|e('html_attr') }}">
        </div>

        <!-- Search Overlay - Enhanced by Svelte -->
        <div data-component="SearchModal"></div>
    </header>

    <main class="main-content">


<!--       <div 
        data-component="HeroOverlay" 
        data-props='{
          "title": "Build Faster with Modern Stack",
          "subtitle": "Combine PHP backend with Svelte frontend for optimal performance",
          "ctaText": "Explore Features", 
          "ctaLink": "/features"
        }'
      ></div> -->

        <div 
          data-component="Hero" 
          data-props='{
            "title": "Your Awesome Platform",
            "subtitle": "Combining PHP power with Svelte elegance",
            "ctaText": "Explore Now",
            "ctaLink": "/features"
          }'
        ></div>

        <!-- Server-rendered Hero -->

        
        <!-- Articles Section - Server rendered -->
        <section class="py-12 bg-white">
            <div class="container mx-auto px-4">
                <h2 class="text-3xl font-bold text-center mb-8">Latest Articles</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {% for article in articles %}
                        <div class="border rounded-lg overflow-hidden shadow-md hover:shadow-lg transition-shadow duration-300">
                            <div class="p-6">
                                <h3 class="text-xl font-semibold mb-2">{{ article.title }}</h3>
                                <p class="text-gray-600 mb-4">{{ article.content|slice(0, 150) }}{% if article.content|length > 150 %}...{% endif %}</p>
                                {% if article.category %}
                                    <span class="inline-block bg-blue-100 text-blue-800 text-xs px-2 py-1 rounded-full">
                                        {{ article.category.name }}
                                    </span>
                                {% endif %}
                                {% if article.tag %}
                                    <span class="inline-block bg-green-100 text-green-800 text-xs px-2 py-1 rounded-full ml-2">
                                        {{ article.tag }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    {% else %}
                        <div class="col-span-3 text-center py-8">
                            <p class="text-gray-500">No articles found.</p>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    </main>

    <script type="module" src="/assets/app.js"></script>
</body>
</html>